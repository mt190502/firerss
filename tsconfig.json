{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "allowJs": true,
        "checkJs": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "lib": ["ES2022", "DOM"],
        "module": "Node16",
        "moduleResolution": "Node16",
        "noEmitOnError": true,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "removeComments": true,
        "skipLibCheck": true,
        "sourceMap": false,
        "strict": true,
        "target": "ESNext",
        "types": ["node"]
    },
    "compileOnSave": true,
    "exclude": ["node_modules/*", "dist", "build", "**/*.spec.ts", "**/*.test.ts"],
    "include": ["static/js/**/*.js", "**/webpack.common.ts", "**/webpack.dev.ts"]
}
