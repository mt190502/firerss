{
    "name": "firerss",
    "version": "3.1.0",
    "description": "Detects RSS and Atom feed candidates on pages and site origins",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mt190502/firerss.git"
    },
    "keywords": [
        "rss",
        "atom",
        "feed",
        "scraper",
        "webextension",
        "firefox",
        "chromium"
    ],
    "author": "Taha (mt190502)",
    "license": "GPL-3.0",
    "bugs": {
        "url": "https://github.com/mt190502/firerss/issues"
    },
    "homepage": "https://github.com/mt190502/firerss",
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.1",
        "@types/chrome": "^0.2.5",
        "@types/firefox-webext-browser": "^143.0.0",
        "@types/node": "^26.1.2",
        "@typescript-eslint/eslint-plugin": "^8.66.0",
        "@typescript-eslint/parser": "^8.66.0",
        "copy-webpack-plugin": "^14.0.0",
        "eslint": "^10.8.0",
        "globals": "^17.9.0",
        "prettier": "^3.9.6",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "webpack": "^5.109.2",
        "webpack-cli": "^7.2.2",
        "webpack-merge": "^6.0.1"
    },
    "scripts": {
        "depInstall": "pnpm install && pnpm update",
        "eslint": "eslint .",
        "eslint:fix": "eslint . --fix",
        "prettier": "prettier --check 'chromium/src/**/*.ts' 'firefox/src/**/*.ts' 'static/**/*.{css,html,js}'",
        "prettier:fix": "prettier --write 'chromium/src/**/*.ts' 'firefox/src/**/*.ts' 'static/**/*.{css,html,js}'",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p chromium/tsconfig.json --noEmit && tsc -p firefox/tsconfig.json --noEmit",
        "build:firefox": "tsc -p tsconfig.json --noEmit && tsc -p firefox/tsconfig.json --noEmit && webpack --mode=production --config firefox/webpack.common.ts",
        "start:firefox": "webpack --mode=development --config firefox/webpack.dev.ts --watch",
        "build:chromium": "tsc -p tsconfig.json --noEmit && tsc -p chromium/tsconfig.json --noEmit && webpack --mode=production --config chromium/webpack.common.ts",
        "start:chromium": "webpack --mode=development --config chromium/webpack.dev.ts --watch"
    }
}
